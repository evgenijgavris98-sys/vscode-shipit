FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json eslint.config.mjs ./
COPY src ./src
RUN npm ci --no-audit --no-fund
RUN npm run compile

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY package.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/out ./out
RUN mkdir -p /var/lib/biorichebrain && chown -R node:node /app /var/lib/biorichebrain
USER node
ENV BIORICHEBRAIN_HOST=0.0.0.0
ENV BIORICHEBRAIN_PORT=8787
ENV BIORICHEBRAIN_DATA_DIR=/var/lib/biorichebrain
EXPOSE 8787
CMD ["node", "out/bioricheBrain/headlessService.js"]
