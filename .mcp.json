{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "firecrawl": {
      "url": "https://mcp.firecrawl.dev/v2/mcp"
    },
    "glif": {
      "url": "https://glif.app/api/mcp"
    },
    "perplexity": {
      "url": "https://api.perplexity.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${env:PERPLEXITY_API_KEY}"
      }
    },
    "chrome": {
      "url": "http://127.0.0.1:12306/mcp"
    }
  }
}
